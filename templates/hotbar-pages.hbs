{{!-- Actor → hotbar page assignments. Rendered by HotbarPagesConfig.
     ApplicationV2 requires each part to render exactly one root element, hence
     the wrapper. --}}
<div class="ee-hotbar-pages-body">

<p class="notes">{{localize "EE.HotbarPages.Notes"}}</p>

<fieldset>
  <legend>{{localize "EE.HotbarPages.GeneralLegend"}}</legend>

  <div class="form-group">
    <label for="ee-hotbar-enabled">{{localize "EE.Settings.HotbarPageSwap.Name"}}</label>
    <div class="form-fields">
      <input type="checkbox" id="ee-hotbar-enabled" name="hotbarPageSwap"
             {{#if enabled}}checked{{/if}}>
    </div>
    <p class="hint">{{localize "EE.Settings.HotbarPageSwap.Hint"}}</p>
  </div>

  <div class="form-group">
    <label for="ee-hotbar-default-page">{{localize "EE.HotbarPages.DefaultLabel"}}</label>
    <div class="form-fields">
      <select id="ee-hotbar-default-page" name="defaultPage">
        {{#each defaultOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "EE.HotbarPages.DefaultHint"}}</p>
  </div>

  <div class="form-group">
    <label for="ee-hotbar-apply-players">{{localize "EE.HotbarPages.ApplyToPlayersLabel"}}</label>
    <div class="form-fields">
      <input type="checkbox" id="ee-hotbar-apply-players" name="applyToPlayers"
             {{#if applyToPlayers}}checked{{/if}}>
    </div>
    <p class="hint">{{localize "EE.HotbarPages.ApplyToPlayersHint"}}</p>
  </div>
</fieldset>

<fieldset>
  <legend>{{localize "EE.HotbarPages.AssignmentsLegend"}}</legend>

  {{#if hasActors}}
    {{#if hasRows}}
      <ol class="ee-hotbar-rows">
        {{#each rows}}
          <li class="ee-hotbar-row" data-ee-row>
            <select name="actorId" aria-label="{{localize "EE.HotbarPages.ActorLabel"}}">
              <option value="">{{localize "EE.HotbarPages.ActorBlank"}}</option>
              {{#each this.actorOptions}}
                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>

            <select name="page" aria-label="{{localize "EE.HotbarPages.PageLabel"}}">
              {{#each this.pageOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>

            <button type="button" class="ee-hotbar-remove" data-ee="remove"
                    data-tooltip="{{localize "EE.HotbarPages.Remove"}}"
                    aria-label="{{localize "EE.HotbarPages.Remove"}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="notes">{{localize "EE.HotbarPages.NoAssignments"}}</p>
    {{/if}}

    <button type="button" class="ee-hotbar-add" data-ee="add">
      <i class="fa-solid fa-plus"></i>
      {{localize "EE.HotbarPages.Add"}}
    </button>
  {{else}}
    <p class="notes">{{localize "EE.HotbarPages.NoActors"}}</p>
  {{/if}}
</fieldset>

<footer class="form-footer">
  <button type="button" data-ee="cancel">
    <i class="fa-solid fa-xmark"></i>
    {{localize "EE.HotbarPages.Cancel"}}
  </button>
  <button type="button" data-ee="save">
    <i class="fa-solid fa-floppy-disk"></i>
    {{localize "EE.HotbarPages.Save"}}
  </button>
</footer>

</div>
