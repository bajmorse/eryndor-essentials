{{!-- Contents of the floating Tokens on Scene bar (see src/tokens/token-bar.ts).
     Rendered into a root <aside> the module creates and keeps, so this is the
     inside of the bar rather than the bar itself. Clicks are read off
     `data-ee-token` by one delegated listener on that root; the header carries
     `data-ee-drag`, which is what the drag listener looks for. --}}
<header class="ee-token-bar-header" data-ee-drag data-tooltip="{{dragTooltip}}">
  <i class="fa-solid fa-grip-lines"></i>
  <span class="ee-token-bar-title">{{title}}</span>
</header>

<ul class="ee-token-bar-list">
  {{#each tokens}}
  <li>
    <button type="button" class="ee-token-bar-row{{#if this.controlled}} active{{/if}}"
            data-ee-token="{{this.id}}" aria-pressed="{{#if this.controlled}}true{{else}}false{{/if}}">
      <img class="ee-token-bar-portrait" src="{{this.img}}" alt="">
      <span class="ee-token-bar-name">{{this.name}}</span>
    </button>
  </li>
  {{/each}}
</ul>
