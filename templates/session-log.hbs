{{!-- The Session Log window. Untabbed, so this is a plain body wrapper —
     ApplicationV2 requires each part to render exactly one root element. The
     `name` on the input matches its key in SETTINGS, which is how ConfigWindow
     reads it back on save. --}}
<div class="ee-config-body">

  <fieldset>
    <legend>{{localize "EE.SessionLog.GeneralLegend"}}</legend>

    <div class="form-group">
      <label for="ee-session-log-enabled">{{localize "EE.Settings.SessionLogEnabled.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-session-log-enabled" name="sessionLogEnabled"
               {{#if sessionLogEnabled}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.SessionLogEnabled.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "EE.SessionLog.CategoriesLegend"}}</legend>

    <div class="form-group">
      <label for="ee-session-log-rolls">{{localize "EE.Settings.SessionLogRolls.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-session-log-rolls" name="sessionLogRolls"
               {{#if sessionLogRolls}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.SessionLogRolls.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-session-log-resources">{{localize "EE.Settings.SessionLogResources.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-session-log-resources" name="sessionLogResources"
               {{#if sessionLogResources}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.SessionLogResources.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-session-log-status">{{localize "EE.Settings.SessionLogStatus.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-session-log-status" name="sessionLogStatus"
               {{#if sessionLogStatus}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.SessionLogStatus.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-session-log-combat">{{localize "EE.Settings.SessionLogCombat.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-session-log-combat" name="sessionLogCombat"
               {{#if sessionLogCombat}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.SessionLogCombat.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-session-log-scenes">{{localize "EE.Settings.SessionLogScenes.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-session-log-scenes" name="sessionLogScenes"
               {{#if sessionLogScenes}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.SessionLogScenes.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-session-log-flags">{{localize "EE.Settings.SessionLogFlags.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-session-log-flags" name="sessionLogFlags"
               {{#if sessionLogFlags}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.SessionLogFlags.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "EE.SessionLog.ExportLegend"}}</legend>

    <div class="form-group">
      <button type="button" data-ee="export">
        <i class="fa-solid fa-file-export"></i>
        {{localize "EE.SessionLog.ExportButton"}}
      </button>
      <p class="hint">{{localize "EE.SessionLog.ExportHint"}}</p>
    </div>
  </fieldset>

</div>
