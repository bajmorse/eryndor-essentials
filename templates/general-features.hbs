{{!-- The General Features window. Untabbed, so this is a plain body wrapper —
     ApplicationV2 requires each part to render exactly one root element. The
     `name` on each input matches its key in SETTINGS, which is how ConfigWindow
     reads them back on save. --}}
<div class="ee-config-body">

  <fieldset>
    <legend>{{localize "EE.GeneralFeatures.TokensLegend"}}</legend>

    <div class="form-group">
      <label for="ee-hide-dm-tokens">{{localize "EE.Settings.HideDmTokens.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-hide-dm-tokens" name="hideDmTokens"
               {{#if hideDmTokens}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.HideDmTokens.Hint"}}</p>
    </div>

    {{!-- Greyed out by `refreshControls` while the master switch above is off:
         this only ever applies to tokens that switch has hidden. --}}
    <div class="form-group">
      <label for="ee-block-token-interaction">{{localize "EE.Settings.BlockPlayerTokenInteraction.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-block-token-interaction" name="blockPlayerTokenInteraction"
               {{#if blockPlayerTokenInteraction}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.BlockPlayerTokenInteraction.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-disable-drag-animation">{{localize "EE.Settings.DisableDragAnimation.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-disable-drag-animation" name="disableDragAnimation"
               {{#if disableDragAnimation}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.DisableDragAnimation.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-token-bar">{{localize "EE.Settings.TokenBar.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-token-bar" name="tokenBar"
               {{#if tokenBar}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.TokenBar.Hint"}}</p>
    </div>

    {{!-- Greyed out by `refreshControls` while the bar is off: the lock is what
         makes an empty selection impossible, and the bar is the only way back
         when it can't. See GeneralFeaturesConfig. --}}
    <div class="form-group">
      <label for="ee-token-bar-lock">{{localize "EE.Settings.TokenBarLockSelection.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-token-bar-lock" name="tokenBarLockSelection"
               {{#if tokenBarLockSelection}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.TokenBarLockSelection.Hint"}}</p>
    </div>

  </fieldset>

  <fieldset>
    <legend>{{localize "EE.GeneralFeatures.PortraitsLegend"}}</legend>

    <div class="form-group">
      <label for="ee-refresh-portraits">{{localize "EE.Settings.RefreshRaisedPortraits.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-refresh-portraits" name="refreshRaisedPortraits"
               {{#if refreshRaisedPortraits}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.RefreshRaisedPortraits.Hint"}}</p>
    </div>
  </fieldset>

  {{!-- Both switches act on Daggerheart: Quick Actions' Request Roll windows.
       With that module inactive `refreshControls` greys them out and the warning
       below says why — see GeneralFeaturesConfig. --}}
  <fieldset>
    <legend>{{localize "EE.GeneralFeatures.RollRequestsLegend"}}</legend>

    {{#unless quickActionsActive}}
      <p class="notes ee-status-warn">
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "EE.GeneralFeatures.QuickActionsMissing"}}
      </p>
    {{/unless}}

    <div class="form-group">
      <label for="ee-roll-request-close">{{localize "EE.Settings.RollRequestClose.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-roll-request-close" name="rollRequestClose"
               {{#if rollRequestClose}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.RollRequestClose.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-roll-request-options">{{localize "EE.Settings.RollRequestOptions.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-roll-request-options" name="rollRequestOptions"
               {{#if rollRequestOptions}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.RollRequestOptions.Hint"}}</p>
    </div>
  </fieldset>

  <p class="hint">{{localize "EE.GeneralFeatures.Version"}} {{version}}</p>

</div>
