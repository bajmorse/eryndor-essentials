{{!-- The General Features window. Untabbed, so this is a plain body wrapper —
     ApplicationV2 requires each part to render exactly one root element. The
     `name` on each input matches its key in SETTINGS, which is how ConfigWindow
     reads them back on save. --}}
<div class="ee-config-body">

  <fieldset>
    <legend>{{localize "EE.GeneralFeatures.TokensLegend"}}</legend>

    <div class="form-group">
      <label for="ee-hide-dm-tokens">{{localize "EE.Settings.HideDmTokens.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-hide-dm-tokens" name="hideDmTokens"
               {{#if hideDmTokens}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.HideDmTokens.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="ee-disable-drag-animation">{{localize "EE.Settings.DisableDragAnimation.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-disable-drag-animation" name="disableDragAnimation"
               {{#if disableDragAnimation}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.DisableDragAnimation.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "EE.GeneralFeatures.PortraitsLegend"}}</legend>

    <div class="form-group">
      <label for="ee-refresh-portraits">{{localize "EE.Settings.RefreshRaisedPortraits.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="ee-refresh-portraits" name="refreshRaisedPortraits"
               {{#if refreshRaisedPortraits}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "EE.Settings.RefreshRaisedPortraits.Hint"}}</p>
    </div>
  </fieldset>

  <p class="hint">{{localize "EE.GeneralFeatures.Version"}} {{version}}</p>

</div>
